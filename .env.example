# Never commit a real key. Copy this file to .env and fill it locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# deepseek: real API; mock: deterministic offline development and tests.
REPOPILOT_LLM_MODE=mock
REPOPILOT_LLM_MAX_OUTPUT_TOKENS=12000
# Bounded self-correction for the maintenance agent: reviewer-driven coder
# revisions, and test-failure repair attempts (each new patch is re-approved).
REPOPILOT_MAX_REVIEW_REVISIONS=1
REPOPILOT_MAX_REPAIR_ATTEMPTS=2
REPOPILOT_MAX_FILES=400
REPOPILOT_MAX_FILE_BYTES=200000
REPOPILOT_RAG_TOP_K=8
REPOPILOT_RAG_CANDIDATE_K=32
REPOPILOT_RAG_SCORE_THRESHOLD=0.05
REPOPILOT_RAG_MAX_CHUNKS_PER_DOCUMENT=3
REPOPILOT_RAG_CHUNK_TOKENS=512
REPOPILOT_RAG_CHUNK_OVERLAP_TOKENS=64

# Production RAG: BGE-M3 dense retrieval + Qdrant sparse retrieval + reranking.
# Models are downloaded to REPOPILOT_RAG_MODEL_CACHE on first use.
REPOPILOT_RAG_EMBEDDING_PROVIDER=bge-m3
REPOPILOT_RAG_EMBEDDING_MODEL=BAAI/bge-m3
REPOPILOT_RAG_RERANKER_PROVIDER=bge
REPOPILOT_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
REPOPILOT_RAG_DEVICE=auto
REPOPILOT_RAG_MODEL_CACHE=.repopilot/rag/models
REPOPILOT_RAG_EMBEDDING_BATCH_SIZE=8
# Content-addressed embedding cache (float32, ~4 KB per chunk); 0 disables.
REPOPILOT_RAG_EMBEDDING_CACHE_ENTRIES=50000
REPOPILOT_RAG_RERANKER_BATCH_SIZE=4
REPOPILOT_RAG_RERANKER_MAX_LENGTH=1024

# Leave URL empty for embedded persistent Qdrant; Docker Compose overrides it.
REPOPILOT_QDRANT_URL=
REPOPILOT_QDRANT_API_KEY=
REPOPILOT_QDRANT_PATH=.repopilot/rag/qdrant
REPOPILOT_QDRANT_TIMEOUT_SECONDS=30

# auto: Docling when installed, pypdf fallback for text PDFs.
# docling: require OCR/layout parsing; text-only: disable Office/OCR parsing.
REPOPILOT_RAG_DOCUMENT_PARSER=auto
# Output of: docling-tools models download
# Leave empty to auto-detect ~/.cache/docling/models.
REPOPILOT_DOCLING_ARTIFACTS_PATH=
REPOPILOT_RAG_MAX_DOCUMENT_BYTES=25000000
REPOPILOT_RAG_MAX_DOCUMENT_PAGES=200
REPOPILOT_TEST_TIMEOUT_SECONDS=120
REPOPILOT_MAX_CACHED_INDICES=32
REPOPILOT_MAX_WORKERS=4
REPOPILOT_MAX_PENDING_RUNS=16
REPOPILOT_MAX_CACHED_SESSIONS=128

# API and workspace safety. On Windows separate roots with semicolons.
# Remote API calls are rejected unless REPOPILOT_API_TOKEN is configured.
# Docker Compose always needs a token: host requests arrive via the bridge.
REPOPILOT_API_TOKEN=
# Empty means the current working directory. Example: D:\workspace;D:\repos
REPOPILOT_WORKSPACE_ROOTS=

# Unsafe by default: pytest/unittest execute repository code on the host.
# Prefer isolated CI. Enable only for a repository you explicitly trust.
REPOPILOT_ALLOW_HOST_TEST_EXECUTION=0
# 仅在本地可信部署需要连接 Ollama/vLLM/企业内网模型时设为 1。
REPOPILOT_ALLOW_PRIVATE_MODEL_ENDPOINTS=0

# Keep HTTP MCP disabled unless it is behind an authenticated gateway.
REPOPILOT_MCP_ALLOW_REMOTE=0

# Deterministic context compression budgets for each model-facing agent.
REPOPILOT_CONTEXT_MAX_INPUT_TOKENS=64000
REPOPILOT_CONTEXT_PLANNER_TOKENS=28000
REPOPILOT_CONTEXT_CODER_TOKENS=64000
REPOPILOT_CONTEXT_REVIEWER_TOKENS=48000
REPOPILOT_CONTEXT_REFLECTION_TOKENS=32000
REPOPILOT_CONTEXT_MAX_EVIDENCE_ITEM_TOKENS=2000
REPOPILOT_CONTEXT_MAX_FILE_ITEM_TOKENS=12000
REPOPILOT_CONTEXT_MAX_DIFF_TOKENS=24000
REPOPILOT_CONTEXT_MAX_TEST_OUTPUT_TOKENS=8000
